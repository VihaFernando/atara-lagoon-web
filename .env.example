# Public canonical origin (no trailing slash). Used for canonical URLs, sitemap, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://ataralagoon.com

# Optional: email delivery for the booking enquiry form via Resend (https://resend.com).
# If unset, the form still validates and hands the enquiry off to WhatsApp / email instead.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=ataralagoon@gmail.com
# Must be a sender on a domain verified in Resend, e.g. "Atara Lagoon Website <enquiries@ataralagoon.com>"
ENQUIRY_FROM_EMAIL=
